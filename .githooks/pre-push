#!/bin/sh
# origin: service/trend-radar/.githooks/pre-push
# reuse: copy as-is; delegates to tool/checks/test.
#
# Keeps a failing test suite from reaching the remote, where it becomes
# everyone else's problem.
#
# Delegates to tool/checks/test, which the project supplies. Skipped when that
# does not exist.
#
# Bypass with `git push --no-verify` when pushing work in progress on purpose.

set -e

script="tool/checks/test"
[ -x "$script" ] || exit 0

# What the suite proves is a tree, so a push has something to verify only when it carries a tree no
# green run has recorded (#214). Without the cache fragment the hook keeps its old behaviour and
# tests every push, because an unreadable cache is not evidence of anything.
if [ -r tool/checks/tested-tree ]; then
  . tool/checks/tested-tree
  cache=1
else
  cache=0
fi

# The one sanctioned way to re-verify a tree the cache calls green, since --no-verify is forbidden.
forced=0
if [ "$cache" -eq 1 ] && tested_tree_forced; then
  forced=1
fi

# What this push earns (#215 review C2). A cached entry may only skip a suite it is at least as
# strong as: before this, a class-C stamp -- format, lint and three snapshot tests -- skipped exactly
# like a full run. Anything this cannot work out is class A, the strongest thing to have to match.
# The GIT_* variables git exports to a hook are dropped for the call: the classifier asks git where
# it is, and under GIT_DIR it would answer for the wrong tree.
#
# #232 review (blocker): $earned has to be what this push actually RUNS, not the classifier's
# unconditional verdict -- tool/checks/test downgrades an owed class A to B under COSMAI_GATE=local
# below, and a cache entry it then writes as B could never satisfy a comparison still asking for A,
# so the identical tree re-pushed (the coordinator's merge carrying it, the cache's whole point)
# would re-run the suite forever. The same downgrade rule applies here: still A, a non-empty owed
# line, and not forced -> B.
earned=A
if [ "$cache" -eq 1 ] && [ -r tool/change_scope.py ] && command -v python3 >/dev/null 2>&1; then
  earned_scope=$( (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
                    python3 tool/change_scope.py origin/main 2>/dev/null) )
  earned=$(printf '%s\n' "$earned_scope" | sed -n 1p)
  earned_owed=$(printf '%s\n' "$earned_scope" | sed -n 4p)
  case "$earned" in
    A | B | C | N) ;;
    *) earned=A ;;
  esac
  if [ "$forced" -eq 0 ] && [ "$earned" = A ] && [ -n "$earned_owed" ]; then
    earned=B
  fi
fi

# git feeds the refs being pushed on stdin, one per line:
#
#   <local ref> <local sha> <remote ref> <remote sha>
#
# and a deletion carries an all-zero local sha. Deleting a remote branch
# cannot break anything the suite would catch, so testing it is pure delay —
# and on a machine where the suite cannot run at all, it makes tidying up a
# merged branch impossible without --no-verify, which is a habit worth not
# teaching.
#
# Anything unexpected on stdin, including nothing at all, falls through to
# running the tests. The safe default is to test.
saw_ref=0
pushing_content=0
untested=0
untested_tree=""
tested_tree=""
tested_stamp=""
while read -r _ local_sha _ _; do
  saw_ref=1
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  pushing_content=1

  tree=$(git rev-parse "$local_sha^{tree}" 2>/dev/null) || tree=""

  if [ "$forced" -eq 0 ]; then
    if [ "$cache" -eq 1 ] && [ -n "$tree" ]; then
      stamp=$(tested_tree_stamp "$tree")
      recorded=$(tested_tree_class "$stamp")
      if [ -n "$stamp" ] \
         && [ "$(tested_tree_rank "$recorded")" -ge "$(tested_tree_rank "$earned")" ]; then
        tested_tree=$tree
        tested_stamp=$stamp
        continue
      fi
    fi
    # #197: a commit that is already on origin/main was verified before it got there, whatever this
    # clone happens to remember — re-testing it is the same tree twice. Checked on its own, so an
    # unreadable cache fragment does not take this skip down with it.
    if git merge-base --is-ancestor "$local_sha" origin/main 2>/dev/null; then
      tested_tree=$tree
      tested_stamp="on origin/main"
      continue
    fi
  fi
  untested=1
  [ -n "$untested_tree" ] || untested_tree=$tree
done

if [ "$saw_ref" -eq 1 ] && [ "$pushing_content" -eq 0 ]; then
  printf '· deletions only, skipping the tests\n'
  exit 0
fi

if [ "$saw_ref" -eq 1 ] && [ "$untested" -eq 0 ] && [ -n "$tested_tree" ]; then
  printf 'pre-push: tree %s tested %s, skipping the suite\n' \
    "$(git rev-parse --short "$tested_tree")" "$tested_stamp"
  exit 0
fi

if [ -n "$untested_tree" ] && [ "$forced" -eq 1 ]; then
  printf 'pre-push: tree %s forced by COSMAI_FORCE_SUITE=1, running the suite\n' \
    "$(git rev-parse --short "$untested_tree")"
elif [ -n "$untested_tree" ]; then
  printf 'pre-push: tree %s untested for class %s, running the suite\n' \
    "$(git rev-parse --short "$untested_tree")" "$earned"
else
  printf '→ test\n'
fi
# --changed: the suite the push has to pay for is the one this change can break (#215). The base is
# origin/main because that is what the push is measured against; a checkout that has no origin/main
# gets class A from the classifier, which is the same suite this line ran before.
#
# COSMAI_GATE=local (#232): CI runs class A on every push now, so this push never has to -- a
# trigger, gate or merge change that would have earned A locally instead runs the computed set it
# owes, and tool/checks/test prints that it is owed. COSMAI_FORCE_SUITE=1 still forces a real local
# A (the offline fallback, #214); tool/checks/test itself honours that.
COSMAI_GATE=local "$script" --changed origin/main || {
  printf '\033[31m✗ Tests failed. Push blocked.\033[0m\n' >&2
  exit 1
}
