#!/bin/sh
# Reads both repos as one issue graph and answers the four questions the rules in
# AGENTS.md need answered: what is startable and what resources are already held,
# what should be looked at again, what breaks a rule, what has drifted.
#
# There is no write subcommand on purpose. The rules in #60 live or die on being
# readable -- `gh issue list` shows neither sub-issue order nor blockedBy -- and a
# boot that loses this tool degrades to `gh issue list -l ch:<x>`, which is worse
# but cannot damage anything.
#
# audit and recheck test the checkout's own TODO(#n) markers and paths, so both pick a "primary" repo
# from the checkout's `origin` remote rather than always the first of REPOS (#174) --
# COSMAI_ISSUE_PRIMARY overrides that read. audit's foreign-closes and fork-behind sections read the
# checkout's `upstream` remote (COSMAI_FOREIGN_CLOSES overrides which script the first one calls),
# and are skipped when there is no such remote. Nothing here fetches.

set -e

# ${0%/*} rather than dirname: the degrade path must still reach prerequisite on a
# host that is missing coreutils, not die with "dirname: not found".
case "$0" in */*) issue_tool_dir=${0%/*} ;; *) issue_tool_dir=. ;; esac
. "$issue_tool_dir/checks/prerequisite"
require_command gh jq git

# One graph, two repos: the fork's issues block upstream's (cosmai#55 <- fork#6).
REPOS=${COSMAI_ISSUE_REPOS:-"slopindustries/cosmai slopindustries/cosmai-import-ydc"}

# The checked-out repo, not the first entry of REPOS, is what audit's TODO(#n)/path checks must test
# against -- a fork checkout's TODO(#n) markers point at fork issues, not upstream's (#174).
# COSMAI_ISSUE_PRIMARY stands in for `git remote get-url origin` so a test can fake a checkout that
# has no real remote; it is read only when the override is unset. Matched by repo name alone --
# REPOS' owner and origin's owner drift independently of one another, and every caller of
# pick_primary keeps only ${primary##*/} anyway.
pick_primary() {
    origin=${COSMAI_ISSUE_PRIMARY:-$(git remote get-url origin 2>/dev/null || true)}
    origin_repo=$(printf '%s' "$origin" | sed -E 's#\.git$##; s#.*/##')
    for repo in $REPOS; do
        if [ "${repo##*/}" = "$origin_repo" ]; then
            printf '%s' "$repo"
            return
        fi
    done
    # Falls back to the old fixed choice rather than failing: a checkout whose origin is renamed
    # or missing should not lose audit/recheck entirely, only the fork-vs-upstream distinction.
    printf 'tool/issue: checkout origin repo (%s) matches no REPOS entry by name; defaulting to %s\n' \
        "$origin_repo" "${REPOS%% *}" >&2
    printf '%s' "${REPOS%% *}"
}

# #232 Work 3: `ready` shows the CI status of each open issue branch's tip -- the whole reason CI,
# not a worker's push, runs class A is worth nothing if a red run is invisible until someone opens
# the workflow by hand. One `gh api` call per branch, tolerated: `gh` is required at the top of this
# script, so a failure here is the API call itself, not a missing binary.
#
# Prints a JSON object {"<channel>#<issue number>": "<status>"} on stdout, built from every origin
# branch shaped like a worker's own (`<channel>/<n>-<slug>`) -- a wave branch names no single issue,
# so it is not looked up here.
collect_ci_status() {
    ci_primary=$1
    ci_tmp=$(mktemp)
    git for-each-ref refs/remotes/origin --format='%(refname:short) %(objectname)' 2>/dev/null \
    | while read -r ci_ref ci_sha; do
        ci_name=${ci_ref#origin/}
        case "$ci_name" in
            */[0-9]*-*) ;;
            *) continue ;;
        esac
        ci_tail=${ci_name##*/}
        ci_number=${ci_tail%%-*}
        case "$ci_number" in
            '' | *[!0-9]*) continue ;;
        esac
        ci_channel=${ci_name%/*}
        if ci_conclusion=$(gh api "repos/$ci_primary/commits/$ci_sha/check-runs" \
            --jq '([.check_runs[] | select(.name == "class-a")]
                   | if length == 0 then "none"
                     elif .[0].conclusion == null then "pending"
                     else .[0].conclusion end)' 2>/dev/null); then
            :
        else
            ci_conclusion=unavailable
        fi
        printf '%s\t%s\n' "$ci_channel#$ci_number" "$ci_conclusion"
    done > "$ci_tmp"
    jq -R -s 'split("\n") | map(select(length > 0) | split("\t")) | map({(.[0]): .[1]}) | add // {}' \
        "$ci_tmp"
    rm -f "$ci_tmp"
}

# #233 (#228 D4'): whether the same branch owes a green class-A run before it merges -- cheap
# enough for every open branch because it only diffs two refs already on `origin`, never checking
# the branch out (tool/ci_owed.py, which reads tests/scope.toml's gate/trigger lists).
collect_ci_owed() {
    co_tmp=$(mktemp)
    git for-each-ref refs/remotes/origin --format='%(refname:short)' 2>/dev/null \
    | while read -r co_ref; do
        co_name=${co_ref#origin/}
        case "$co_name" in
            */[0-9]*-*) ;;
            *) continue ;;
        esac
        co_tail=${co_name##*/}
        co_number=${co_tail%%-*}
        case "$co_number" in
            '' | *[!0-9]*) continue ;;
        esac
        co_channel=${co_name%/*}
        co_answer=$(python3 "$issue_tool_dir/ci_owed.py" "origin/$co_name" "origin/main" 2>/dev/null) \
            || co_answer="unavailable"
        printf '%s\t%s\n' "$co_channel#$co_number" "$co_answer"
    done > "$co_tmp"
    jq -R -s 'split("\n") | map(select(length > 0) | split("\t")) | map({(.[0]): .[1]}) | add // {}' \
        "$co_tmp"
    rm -f "$co_tmp"
}

# #232 Work 3: the last scheduled (nightly) run of suite.yml -- what `tool/issue audit` puts first
# and `tool/status`'s `== ci ==` block repeats. {"available": false} when the call itself failed,
# distinct from {"available": true, "run": null} when it answered with no scheduled run at all.
nightly_status() {
    nightly_primary=$1
    if nightly_raw=$(gh api \
        "repos/$nightly_primary/actions/workflows/suite.yml/runs?event=schedule&per_page=1" \
        2>/dev/null); then
        printf '%s' "$nightly_raw" | jq '{available: true, run: (.workflow_runs[0] // null)}'
    else
        printf '%s' '{"available": false}'
    fi
}

STALE_HOURS=24
MEMO_DAYS=14
RECHECK_DAYS=14
# From this date on, a newly opened issue written in Korean is a lint finding (#192 D12). The
# coordinator sets it to the day this wave lands on main; issues opened before it are left alone,
# because flagging them all at once would report both backlogs and the rule would be ignored.
LANG_EFFECTIVE_DATE=2026-09-04
# recheck (e) asks which open issues a just-closed goal or decision moved. A week is how long a
# closing is still news; older than that and every boot would re-report the same issues forever.
CLOSED_DAYS=7
CLOSED_PAGE=50
SHARED_LABELS='["channel","goal","decision","memo","when-touched","needs-user"]'

usage() {
    cat >&2 <<'EOF'
usage: tool/issue <command>

  ready [--user] [--json]   held resources, then startable issues per channel in queue order
  recheck [--json]          open issues to look at again, and why; exit 1 when there is one
  lint [--json]             rule violations; exit 1 when there is one
  audit                     drift report; exit 0

Boot order is audit, then recheck, then ready (AGENTS.md). A step of an ops issue or of a
wave epic is written with tool/journal, not here: this tool never writes.

env:
  COSMAI_ISSUE_PRIMARY   overrides the checkout's origin repo (tests only; default: git remote get-url origin)
  COSMAI_FOREIGN_CLOSES  overrides the foreign-closes script audit's last section calls
EOF
    exit 64
}

# The repository is named inline rather than passed as a variable so that anything
# reading the call -- a log, the offline test's fake gh -- can tell the repos apart.
query_for() {
    cat <<EOF
query(\$cursor: String) {
  repository(owner: "${1%%/*}", name: "${1##*/}") {
    nameWithOwner
    labels(first: 100) { nodes { name } }
    issues(first: 100, states: OPEN, after: \$cursor) {
      pageInfo { hasNextPage endCursor }
      nodes {
        number title updatedAt createdAt body
        labels(first: 20) { nodes { name } }
        assignees(first: 5) { nodes { login } }
        parent { number }
        subIssues(first: 100) { pageInfo { hasNextPage } nodes { number } }
        blockedBy(first: 50) { pageInfo { hasNextPage } nodes { number state repository { nameWithOwner } } }
      }
    }
  }
}
EOF
}

# Closed issues are not part of the shared graph: only recheck (e) wants them, it wants only the
# recent ones, and paying for the whole closed history on every boot would be the wrong trade.
closed_query_for() {
    cat <<EOF
query {
  repository(owner: "${1%%/*}", name: "${1##*/}") {
    nameWithOwner
    issues(first: $CLOSED_PAGE, states: CLOSED, orderBy: {field: UPDATED_AT, direction: DESC}) {
      pageInfo { hasNextPage endCursor }
      nodes { number title body closedAt labels(first: 20) { nodes { name } } }
    }
  }
}
EOF
}

fail() {
    printf '\033[31m✗ %s\033[0m\n' "$1" >&2
    exit 1
}

# Each page is fetched outside any pipeline: dash has no pipefail, so a `gh` that fails inside
# `for ... | jq -s` is swallowed and the repo silently becomes an empty one. A half graph is the
# worst answer this tool can give -- it would call cosmai#55 ready by not seeing fork#6.
fetch_repo() {
    query=${3:-$(query_for "$1")}
    single=${4:-}
    cursor=
    while :; do
        attempt=1
        while :; do
            if [ -z "$cursor" ]; then
                page=$(gh api graphql -f query="$query") || fail "$1: gh api graphql failed"
            else
                page=$(gh api graphql -f query="$query" -F cursor="$cursor") || fail "$1: gh api graphql failed"
            fi
            # `errors` and `data` are not exclusive, and the partial answer is the dangerous one:
            # GitHub reports a nested field that timed out or was throttled with HTTP 200, the outer
            # arrays intact and the nesting emptied. That nesting IS the graph -- `subIssues` carries
            # queue order, `assignees` who is holding what, `blockedBy` the blockers -- so a page with
            # errors is never a smaller truth, it is a queue with pieces silently missing. It cost a
            # session once (cosmai#133): a channel read "0 items" and its first line read "in progress 0" while
            # two workers were mid-flight. Any `errors` is fatal; only the retry below is allowed first.
            errors=$(printf '%s' "$page" | jq -r '[.errors[]?.message] | join("; ")' 2>/dev/null)
            if [ -n "$errors" ]; then
                # Throttling and timeouts are the usual cause and they pass; one backoff is worth
                # more than a boot that has to be restarted by hand. Anything else dies at once.
                case "$errors" in
                    *imeout*|*imit*|*hrottl*|*navailable*|*'try again'*|*'secondary rate'*)
                        if [ "$attempt" = 1 ]; then
                            attempt=2
                            sleep "${COSMAI_ISSUE_RETRY_SECONDS:-2}"
                            continue
                        fi
                        ;;
                esac
                fail "$1: the API answered partially — $errors"
            fi
            printf '%s' "$page" | jq -e '.data.repository.issues.nodes | type == "array"' >/dev/null 2>&1 \
                || fail "$1: the API answered without data"
            break
        done
        printf '%s\n' "$page" >> "$2"
        [ -z "$single" ] || break
        printf '%s' "$page" | jq -e '.data.repository.issues.pageInfo.hasNextPage == true' >/dev/null || break
        cursor=$(printf '%s' "$page" | jq -r '.data.repository.issues.pageInfo.endCursor')
    done
}

MERGE='
[.[].data.repository]
| reduce .[] as $r ({order: [], by: {}};
    (if (.by | has($r.nameWithOwner)) then .
     else (.order += [$r.nameWithOwner]
           | .by[$r.nameWithOwner] = {repo: $r.nameWithOwner, labels: [$r.labels.nodes[].name], issues: []})
     end)
    | .by[$r.nameWithOwner].issues += [$r.issues.nodes[]])
| . as $s | [$s.order[] | $s.by[.]]
'

# The caps on subIssues and blockedBy are per issue, so nothing paginates them; an issue that
# outgrows one page would silently lose queue positions or blockers, which must be said out loud.
TRUNCATED='
[.[] as $r | $r.issues[]
 | select((.subIssues.pageInfo.hasNextPage == true) or (.blockedBy.pageInfo.hasNextPage == true))
 | "· truncated: " + ($r.repo | sub("^[^/]*/"; "")) + "#" + (.number | tostring)
   + " has more subIssues/blockedBy than one page (raise the first: values in tool/issue)"]
| .[]
'

CLOSED_MERGE='[.[].data.repository | {repo: .nameWithOwner, issues: .issues.nodes}]'

closed_graph() {
    pages=$(mktemp)
    trap 'rm -f "$pages"' EXIT
    for repo in $REPOS; do
        fetch_repo "$repo" "$pages" "$(closed_query_for "$repo")" single
    done
    jq -s "$CLOSED_MERGE" < "$pages"
}

graph() {
    pages=$(mktemp)
    merged=$(mktemp)
    trap 'rm -f "$pages" "$merged"' EXIT
    for repo in $REPOS; do
        fetch_repo "$repo" "$pages"
    done
    jq -s "$MERGE" < "$pages" > "$merged"
    jq -r "$TRUNCATED" < "$merged" >&2
    cat "$merged"
}

# Shared vocabulary for every subcommand's jq. `key` is repo-short + "#" + number
# because the two repos share a number space in the output but not in reality.
JQ_LIB='
def shortname: sub("^[^/]*/"; "");
def flat:
  [ .[] as $r | $r.issues[]
    | { repo: $r.repo,
        short: ($r.repo | shortname),
        number: .number,
        title: .title,
        body: (.body // ""),
        updatedAt: .updatedAt,
        createdAt: (.createdAt // ""),
        labels: [.labels.nodes[].name],
        assignees: [.assignees.nodes[].login],
        parent: (.parent.number),
        subs: [.subIssues.nodes[].number],
        blockers: [.blockedBy.nodes[] | {key: ((.repository.nameWithOwner | shortname) + "#" + (.number | tostring)), state: .state}] }
    | .key = (.short + "#" + (.number | tostring)) ];
def tagged($name): (.labels | index($name)) != null;
def channel_labels: [.labels[] | select(startswith("ch:"))];
def channel: (channel_labels | first // null);
def open_blockers: [.blockers[] | select(.state == "OPEN") | .key];
def section($name): (.body | test("(^|\n)#{1,6}[ \t]*" + $name));
def DONE_WHEN: "Done when";
def RELEASE_CONDITION: "Release condition";
def WHEN_TO_FIX: "When to fix";
# Case-insensitive: this one is a word inside a longer heading ("## Channel / grade / size") and
# which case that heading lands in is not for this tool to fix.
def SCALE: "(?i:size)";
# null, not [], when the heading is absent: the caller has to be able to tell "no such section"
# from "the section is empty", and the scale section falls back to the whole body only in the first case.
def section_lines($name):
  (.body | split("\n")) as $l
  | [range(0; $l | length) | select($l[.] | test("^#{1,6}.*" + $name))] as $heads
  | if ($heads | length) == 0 then null
    else ($heads | last) as $start
      | ([range($start + 1; $l | length) | select($l[.] | test("^#{1,6}[ \t]"))] | first // ($l | length)) as $end
      | $l[$start + 1:$end] end;
def scale_lines: section_lines(SCALE) // (.body | split("\n"));
def resource: (scale_lines | join("\n")
               | (capture("Resources:[ \t]*(?<v>[^\n]*)").v // "")) | sub("[ \t\r]+$"; "");
# The token is the first word of each `·`-separated item, so "ops(stop = approval each time)" and
# "sharedDB read" both fold onto the resource they contend for. A resource of "none" collides with
# nothing and is dropped.
def resource_tokens:
  resource | split("·")
  | map(capture("^[ \t]*(?<t>[^ \t(][^ \t(]*)").t | sub("[.,;:]+$"; ""))
  | map(select((. | ascii_downcase) != "none" and . != "")) | unique;
def excluded_from_ready: (tagged("memo") or tagged("channel") or tagged("goal") or tagged("deferred"));
def targets($user): map(select((excluded_from_ready | not) and ($user or (tagged("needs-user") | not))));
def status_of:
  if (.assignees | length) > 0 then {status: "in progress", detail: (.assignees[0] + " since " + .updatedAt)}
  elif (open_blockers | length) > 0 then {status: "blocked", detail: (open_blockers | join(", "))}
  else {status: "ready", detail: null} end;
def item($note): status_of + {key: .key, title: .title, resource: resource,
                              needs_user: tagged("needs-user"), note: $note};
def stray_note: (if .parent == null then "no parent" else "outside the epic" end);
# A fenced block is quoted evidence -- a log line, a seed row, a body being migrated -- so Korean
# inside one is not prose the issue wrote, and rewriting it would falsify the quote.
def outside_fences:
  (split("\n"))
  | reduce .[] as $line ({inside: false, out: []};
      if ($line | test("^[ \t]*```")) then .inside = (.inside | not)
      elif .inside then .
      else .out += [$line] end)
  | .out | join("\n");
# Codepoint escapes, not literal syllables, for the reason tool/checks/lang gives for the same
# choice: this file must not contain the Hangul the rule below exists to catch.
def hangul: test("[\\x{1100}-\\x{11FF}\\x{3130}-\\x{318F}\\x{A960}-\\x{A97F}\\x{AC00}-\\x{D7A3}\\x{FFA0}-\\x{FFDC}]");
def title_tag($en): (.title | startswith("[" + $en + "]"));
# The wave rule names branches without an "origin/" prefix; a scan that mixes local and
# remote-tracking refs has to fold both spellings onto the same channel before comparing them.
def strip_origin: if startswith("origin/") then .[7:] else . end;
def wave_channel: strip_origin as $s | if ($s | startswith("wave/")) then $s[5:] else empty end;
def is_issue_branch_for($ch):
  strip_origin as $s
  | ($s | startswith($ch + "/")) and ($s[($ch | length) + 1:] | test("^[0-9]+-"));
def ready_channels($all; $user):
  ($all | targets($user)) as $t
  | ($t | map({(.key): .}) | add // {}) as $byk
  | ($all | map(select(tagged("channel")))
     | map({channel: (channel // .title), epic: .key, epic_title: .title,
            order: [.subs[] as $n | (.short + "#" + ($n | tostring))]})) as $groups
  | ([$groups[].order[]] | map({(.): true}) | add // {}) as $claimed
  | ($t | map(select($claimed[.key] == null))) as $rest
  | ($groups | map(. as $g | {channel: $g.channel, epic: $g.epic, epic_title: $g.epic_title,
        items: ([$g.order[] | select($byk[.] != null) | $byk[.] | item(null)]
                + [$rest[] | select(channel == $g.channel) | item(stray_note)])})) as $named
  | (([$rest[] | channel | select(. != null)] | unique) - ($named | map(.channel))) as $loose
  | ($loose | map(. as $c | {channel: $c, epic: null, epic_title: null,
        items: [$rest[] | select(channel == $c) | item(stray_note)]})) as $unepic
  | [$rest[] | select(channel == null) | item(stray_note)] as $nochan
  | $named + $unepic
    + (if ($nochan | length) > 0 then [{channel: null, epic: null, epic_title: null, items: $nochan}] else [] end);
'

# The gate this replaces counted workers and ignored what they were touching, so it both blocked a
# startable issue and waved through two issues fighting over the same database (#185).
READY='
flat as $all
| (if $user then
     [$all[] | select(tagged("needs-user")
                      or (tagged("memo") and ($now - (.updatedAt | fromdateiso8601)) > ($memo_days * 86400)))
      | . as $i
      | {key: .key, title: .title, short: .short,
         kind: (if ($i | tagged("needs-user")) then "needs-user" else "memo" end),
         unblocks: ([$all[] | select([.blockers[] | select(.state == "OPEN") | .key] | index($i.key))] | length)}]
     | sort_by(-.unblocks, .short, .key) | map(del(.short))
   else [] end) as $queue
| {held: (
  ($all | map(select((.assignees | length) > 0))) as $running
  | {in_progress: ($running | length),
     resources: ([$running[] | . as $i | resource_tokens[] | {token: ., key: $i.key}]
                 | group_by(.token) | map({resource: .[0].token, keys: [.[].key]}) | sort_by(.resource))}),
   channels: ready_channels($all; $user), user_queue: $queue}
'

RENDER_READY='
def head:
  if .channel == null then "(no channel)"
  elif .epic != null then .channel + " — " + .epic_title + " (" + .epic + ")"
  else .channel + " — (no epic)" end;
# #232 Work 3: only an issue with a branch on origin has anything to show -- $ci carries a key for
# every branch found, so a missing key means no branch, not "ci: none" (that is what a branch with
# no check run yet gets, from collect_ci_status itself).
def ci_suffix($channel):
  # A channel carries its "ch:" label prefix here, but a branch is named after the bare channel
  # (AGENTS.md: `<channel>/<issue#>-<slug>`, e.g. `tool/11-thing`, never `ch:tool/11-thing`).
  ((if ($channel | startswith("ch:")) then $channel[3:] else $channel end)
   + "#" + (.key | split("#")[1])) as $ci_key
  # #233: the A-owed flag rides the same key -- shown only alongside a CI status, since neither
  # means anything for an issue with no branch on origin.
  | if ($ci[$ci_key] // null) != null then
      " · ci: " + $ci[$ci_key] + " · A " + ($owed[$ci_key] // "not owed")
    else "" end;
[.held as $h | "in progress " + ($h.in_progress | tostring)
 + (if ($h.resources | length) == 0 then ""
    else " · held: " + ([$h.resources[] | .resource + " " + (.keys | join(", "))] | join(" · ")) end)]
+ ([.channels[] | . as $c | ["", head]
    + (if (.items | length) == 0 then ["  (none)"]
       else [.items[] | "  " + .key + " · " + .title + (if .needs_user then " [needs-user]" else "" end)
             + " · " + (if .status == "ready" then "ready" else .status + ": " + .detail end)
             + (if .resource != "" then " · resources: " + .resource else "" end)
             + (if .note != null then " (" + .note + ")" else "" end)
             + ci_suffix($c.channel // "")]
       end)] | add // [])
+ (if (.user_queue | length) > 0
   then ["", "User queue"]
        + [.user_queue[] | "  " + .key + " · " + .title + " · " + .kind + " · unblocks " + (.unblocks | tostring)]
   else [] end)
| .[]
'

# AGENTS.md: an open issue is looked at again when a goal or a decision closes, after a wave merge, and
# every 14 days -- against five questions. This reports which issue and which of the five, because
# a bare list of numbers moves the reading work back onto the reader and stops being run.
RECHECK='
def release_dates: [ (section_lines(RELEASE_CONDITION) // []) | join("\n") | scan("[0-9]{4}-[0-9]{2}-[0-9]{2}") ];
# Its own regex, not a rule borrowed from tool/checks/paths: that check greps a staged diff for the
# literal home prefix and has no notion of a quoted path, so there is nothing there to reuse.
# Only backticked, slash-carrying tokens whose first segment is something the checkout actually has:
# bodies are full of `owner/repo` and `ch:collectors/youtube`, and reporting those as missing files
# would put every issue on the list, which is the same as having no list at all.
# A path immediately followed by a parenthetical note ("`stack/x` (planned)", "`stack/x`(fork)") is
# a path the body already marks as not-yet-there or gone; checking it would just restate the note.
def body_paths:
  [ .body | scan("`([^`\n]+)`( ?\\()?") ]
  | map(select((.[1] // "") == ""))
  | map(.[0] | sub(":[0-9]+$"; "") | sub("/$"; ""))
  | map(select(test("^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+$")))
  # A dotfile is normally untracked on purpose (stack/.env), so "not in the checkout" says nothing.
  | map(select((split("/") | last | startswith(".")) | not))
  | unique | map(select($tracked[(split("/") | .[0])] == true));
def days_since($t): (($now - ($t | fromdateiso8601)) / 86400) | floor;
flat as $all
| ([$closed_pages[0][] as $r | $r.issues[]
    | {key: (($r.repo | shortname) + "#" + (.number | tostring)), short: ($r.repo | shortname),
       title: .title, body: (.body // ""), labels: [.labels.nodes[].name], closedAt: .closedAt}
    | select(.closedAt != null and (days_since(.closedAt) <= $closed_days))
    | select((.labels | index("goal")) or (.labels | index("decision"))
             or title_tag("goal") or title_tag("decision"))]) as $moved
# Each edge carries the closing closedAt too, not just the key: (e) goes quiet once the pointed-at
# issue was updated after that closing -- a recheck comment left there is how the signal turns off.
| (reduce ($moved[] | . as $m
     | [.body | scan("[A-Za-z0-9._-]*#[0-9]+")]
     | map(if startswith("#") then ($m.short + .) else . end)
     | unique[] | {ref: ., src: $m}) as $edge
   ({}; .[$edge.ref] += [{key: $edge.src.key, closedAt: $edge.src.closedAt}])) as $points_at
| [$all[] | select(tagged("memo") | not)
   | . as $i
   | (release_dates) as $dates
   | ([ (if days_since(.updatedAt) >= $recheck_days
         then {code: "a", why: ("updated " + (days_since(.updatedAt) | tostring) + " days ago"),
               checks: ["premise", "blockedBy", "release condition", "grade", "duplicate"]} else empty end),
        (if ($dates | length) > 0 and ($dates | max) < $today
         then {code: "b", why: ("release condition " + ($dates | max) + " has passed"),
               checks: ["release condition"]} else empty end),
        # A release-condition section already gives (b) a date to watch, or -- with no date in it --
        # leaves prose that only (a) 14-day cycle can judge; without the section there is nothing
        # else watching this deferred issue, so only then does the missing-blocker gap need saying.
        (if tagged("deferred") and (open_blockers | length) == 0 and (section(RELEASE_CONDITION) | not)
         then {code: "c", why: "deferred with no open blockedBy and no release-condition section",
               checks: ["blockedBy", "release condition"]} else empty end),
        # Only the repo this checkout is: issues in the other repo quote files that live there
        # and not here, and reporting every one of them would drown the reasons that are real.
        ((if .short == $primary then (body_paths | map(select($tracked[.] != true))) else [] end) as $gone
         | if ($gone | length) > 0
           then {code: "d", why: ("the body quotes " + ($gone | join(", ")) + ", not in the checkout"),
                 checks: ["premise"]} else empty end),
        ((($points_at[$i.key] // []) | map(select(.closedAt > $i.updatedAt)) | map(.key)) as $src
         | if ($src | length) > 0
           then {code: "e", why: (($src | join(", ")) + " closed within the last "
                                  + ($closed_days | tostring) + " days"),
                 checks: ["premise", "grade", "duplicate"]} else empty end) ]) as $reasons
   | select(($reasons | length) > 0)
   | {key: .key, short: .short, number: .number, title: .title, reasons: $reasons}]
| sort_by(.short, .number) | map(del(.short, .number))
'

RENDER_RECHECK='
if length == 0 then ["nothing to recheck"]
else ["recheck " + (length | tostring) + " (premise · blockedBy · release condition · grade · duplicate)"]
     + ([.[] | ["", "  " + .key + " · " + .title]
         + [.reasons[] | "    " + .why + " → check: " + (.checks | join(", "))]] | add)
end | .[]
'

# jq has no cycle primitive, so paths are walked and the first repeat is the cycle.
# The depth cap only stops a pathological graph from exhausting the stack.
LINT='
def cycles($edges; $path):
  ($path | last) as $node
  | ($edges[$node] // [])[] as $next
  | ($path | index($next)) as $seen
  | if $seen != null then ($path[$seen:] + [$next])
    elif ($path | length) > 60 then empty
    else cycles($edges; $path + [$next]) end;
def rotate: .[0:-1] as $c | ($c | index(($c | min))) as $i | ($c[$i:] + $c[0:$i]) | . + [.[0]];
flat as $all
| ($all | map({(.key): .}) | add // {}) as $byk
| (reduce $all[] as $i ({}; .[$i.key] = ($i | open_blockers))) as $edges
| ([$all[] | . as $i
    | (if ($i | tagged("memo") or tagged("goal") or tagged("channel")) then empty
       else
         (if (channel_labels | length) != 1 then {key: .key, short: .short, number: .number, reason: "not exactly one ch:* label"} else empty end),
         (if .parent == null then {key: .key, short: .short, number: .number, reason: "no parent epic"} else empty end),
         # A when-touched issue is finished by whatever work next opens that file, not by this issue
         # (the label reads "fixed the next time that file is touched"). Demanding a completion
         # criterion contradicts the label, and that mismatch did in fact keep lint red on issues
         # whose bodies were right (fork #43, #44). The exemption is not an absence of rules -- when
         # it gets fixed still has to be written down, and audit matches the TODO(#n) markers in the
         # code against these issues in both directions on its own.
         (if ($i | tagged("when-touched"))
          then (if section(WHEN_TO_FIX) then empty else {key: .key, short: .short, number: .number, reason: "when-touched issue has no When to fix section"} end)
          else (if section(DONE_WHEN) then empty else {key: .key, short: .short, number: .number, reason: "body has no Done when section"} end)
          end)
       end),
      (if ($i | tagged("memo")) then
         (if (channel_labels | length) > 0 then {key: .key, short: .short, number: .number, reason: "memo has a ch:* label"} else empty end),
         (if .parent != null then {key: .key, short: .short, number: .number, reason: "memo has a parent"} else empty end),
         (if section(DONE_WHEN) then {key: .key, short: .short, number: .number, reason: "memo body has a Done when section"} else empty end)
       else empty end),
      (.blockers[] | select(.state == "OPEN") | select(($byk[.key].labels // []) | index("memo")) | {key: $i.key, short: $i.short, number: $i.number, reason: ("blockedBy memo " + .key)}),
      (if ($i | tagged("deferred")) and (open_blockers | length) == 0 and (section(RELEASE_CONDITION) | not)
       then {key: .key, short: .short, number: .number, reason: "deferred with no open blockedBy and no Release condition section"} else empty end),
      (if (.body | test("/ho" + "me/[A-Za-z0-9._-]")) then {key: .key, short: .short, number: .number, reason: "body contains a machine path (home directory)"} else empty end),
      # #192 D12. Only issues opened on or after the effective date, and only prose: a fenced block
      # is quoted evidence, and rewriting it would falsify the quote.
      (if .createdAt >= $lang_effective and ((.title | hangul) or (.body | outside_fences | hangul))
       then {key: .key, short: .short, number: .number,
             reason: ("Korean in the title or body of an issue opened on or after " + $lang_effective)} else empty end)]
   | sort_by(.short, .number, .reason)) as $findings
| ([$all[] | .key as $k | cycles($edges; [$k])] | map(rotate) | unique
   | map({key: .[0], short: (.[0] | split("#")[0]), number: 0, reason: ("blockedBy cycle — " + join(" → "))})) as $loops
| $findings + $loops
'

AUDIT='
. as $repos
| flat as $all
| (reduce (ready_channels($all; true)[]) as $c ({};
     .[$c.channel // "(no channel)"] = ([$c.items[] | select(.needs_user)] | length))) as $waiting
| {
  channels: [ready_channels($all; false)[]
    | {channel: (.channel // "(no channel)"), epic: (.epic // "no epic"), length: (.items | length),
       head: (.items | first | if . == null then null else .key + " · " + .title end),
       needs_user: ($waiting[(.channel // "(no channel)")] // 0)}],
  stale_in_progress: [$all[] | select((.assignees | length) > 0 and ($now - (.updatedAt | fromdateiso8601)) > ($stale_hours * 3600))
    | {key: .key, assignee: .assignees[0], hours: ((($now - (.updatedAt | fromdateiso8601)) / 3600) | floor)}],
  old_memos: ([$all[] | select(tagged("memo") and ($now - (.updatedAt | fromdateiso8601)) > ($memo_days * 86400)) | .key]),
  stale_open: [$all[] | select(.short == $primary) | . as $i
    | ($merged | map(select(test("/" + ($i.number | tostring) + "-")))) as $branches
    | select(($branches | length) > 0) | {key: $i.key, branches: $branches}],
  todo_without_issue: [$todos[] | . as $line | ($line | capture("TODO\\(#(?<n>[0-9]+)\\)").n | tonumber) as $n
    | select([$all[] | select(.short == $primary and .number == $n and tagged("when-touched"))] | length == 0)
    | $line],
  when_touched_without_todo: [$all[] | select(.short == $primary and tagged("when-touched"))
    | . as $i | select([$todos[] | select(test("TODO\\(#" + ($i.number | tostring) + "\\)"))] | length == 0) | .key],
  unreachable_tests: $unreachable,
  merged_worktrees: [$worktrees[] | split("\t") | {path: .[0], branch: .[1]}
    | .branch as $b | select($b != "main" and ($merged | index($b)) != null)],
  # #196: a wave branch merged into main but never deleted (locally or on origin) leaves the next
  # wave of the same channel to start from a stale base -- invisible to every check that keys on
  # "/<n>-" because a wave branch carries no issue number. Guarded against the fresh-open-wave case
  # (wave/<ch> == main while the wave is still open) by requiring no unmerged issue branch remain.
  merged_wave_channels: (
    ([$merged_all[] | wave_channel] | unique) as $mwc
    | [$mwc[] as $ch | select([$unmerged_all[] | select(is_issue_branch_for($ch))] | length == 0) | $ch]
  ),
  missing_labels: [$repos[] | {repo: .repo, missing: ('"$SHARED_LABELS"' - .labels)} | select((.missing | length) > 0)],
  foreign_closes: $foreign_closes,
  fork_behind: $fork_behind,
  ownership: $ownership,
  # #232 Work 3: the nightly is a warning the moment it is red, missing, or older than 36h -- a
  # green run from two days ago is not evidence today ran clean, it is evidence the schedule died.
  nightly: (
    if ($nightly.available | not) then
      {line: "(unavailable)", warn: false}
    elif ($nightly.run == null) then
      {line: "no scheduled run found", warn: true}
    else
      ($nightly.run.conclusion // "null") as $concl
      | (($now - ($nightly.run.created_at | fromdateiso8601)) / 3600) as $age_hours
      | {line: ($nightly.run.created_at + " " + $concl
                + (if $age_hours > 36 then " (" + ($age_hours | floor | tostring) + "h old)" else "" end)),
         warn: ($concl != "success" or $age_hours > 36)}
    end
  ),
  # #233 Work 3: pipeline_health/collector_health rows, read straight through -- $ops carries
  # "(unavailable)" when docker or the container itself could not answer both queries.
  ops_available: $ops_available,
  ops: $ops
}
'

RENDER_AUDIT='
def block($title; $lines): ["", $title] + (if ($lines | length) == 0 then ["  none"] else $lines end);
(["", "nightly"] + ["  " + .nightly.line + (if .nightly.warn then " ⚠" else "" end)])
+ (["", "ops"] + (if (.ops_available | not) then ["  (unavailable)"]
                  elif (.ops | length) == 0 then ["  none"]
                  else [.ops[] | "  " + .] end))
+ block("Queue per channel"; [.channels[] | "  " + .channel + " (" + .epic + ") · " + (.length | tostring) + " open"
      + (if .needs_user > 0 then " · needs-user " + (.needs_user | tostring) else "" end)
      + " · head " + (.head // "none")])
+ block("Started but idle (no change for 24h+)"; [.stale_in_progress[] | "  " + .key + " · " + .assignee + " · " + (.hours | tostring) + "h"])
+ block("memo older than 14 days (" + (.old_memos | length | tostring) + ")"; [.old_memos[] | "  " + .])
+ block("stale-open (a merged branch exists but the issue is open)"; [.stale_open[] | "  " + .key + " ← " + (.branches | join(", "))])
+ block("TODO(#n) marker with no open when-touched issue"; [.todo_without_issue[] | "  " + .])
+ block("open when-touched issue with no marker in the code"; [.when_touched_without_todo[] | "  " + .])
+ block("test file no rule reaches"; [.unreachable_tests[] | "  " + .])
+ block("Worktree left behind after its branch was merged"; [.merged_worktrees[] | "  " + .path + " (" + .branch + ")"])
+ block("Merged wave branch left behind"; [.merged_wave_channels[] | "  wave/" + .])
+ block("Shared label missing from a repo"; [.missing_labels[] | "  " + .repo + ": " + (.missing | join(", "))])
+ block("Closed by a commit that belongs to the other repo"; [.foreign_closes[] | "  " + .])
+ block("fork behind on shared surfaces"; [.fork_behind[] | "  " + .])
+ block("fork changed a file upstream owns"; [.ownership[] | "  " + .])
| .[]
'

cmd=${1:-}
[ -n "$cmd" ] || usage
shift

as_json=0
as_user=false
for arg in "$@"; do
    case "$arg" in
        --json) as_json=1 ;;
        --user) as_user=true ;;
        *) usage ;;
    esac
done

# Checked before the fetch so a mistyped flag costs no API call.
[ "$cmd" != audit ] || [ "$as_json" = 0 ] || usage

now=$(date -u +%s)
# The graph is read before anything is printed, and `set -e` stops here if a repo could not be
# fetched: a pipeline would hand jq an empty stream and report the exit code of jq instead.
graph_json=$(graph)

case "$cmd" in
    ready)
        model=$(printf '%s' "$graph_json" | jq --argjson now "$now" --argjson user "$as_user" \
            --argjson memo_days "$MEMO_DAYS" "$JQ_LIB $READY")
        if [ "$as_json" = 1 ]; then
            printf '%s\n' "$model"
        else
            # #232 Work 3: the ci lookup only matters for the rendered form -- --json is the model
            # a script reads, and a script that wants CI status calls the API itself.
            ci_json=$(collect_ci_status "$(pick_primary)")
            owed_json=$(collect_ci_owed)
            printf '%s' "$model" | jq -r --argjson ci "$ci_json" --argjson owed "$owed_json" "$RENDER_READY"
        fi
        ;;
    recheck)
        # Reason (d) asks whether the checkout still has what the body quotes. Tracked paths only,
        # with every ancestor directory, so an untracked scratch file cannot answer for a path that
        # is really gone and so a quoted directory resolves.
        primary=$(pick_primary)
        tracked=$(git ls-files 2>/dev/null | awk '{ print; p = $0; while (sub("/[^/]*$", "", p)) print p }' \
            | sort -u | jq -R -s 'split("\n") | map(select(length > 0)) | map({(.): true}) | add // {}')
        # A file rather than --argjson: two pages of closed bodies overflow the argument list.
        closed_file=$(mktemp)
        trap 'rm -f "$closed_file"' EXIT
        closed_graph > "$closed_file"
        items=$(printf '%s' "$graph_json" | jq --argjson now "$now" --arg today "$(date -u +%Y-%m-%d)" \
            --argjson recheck_days "$RECHECK_DAYS" --argjson closed_days "$CLOSED_DAYS" \
            --argjson tracked "$tracked" --slurpfile closed_pages "$closed_file" \
            --arg primary "${primary##*/}" "$JQ_LIB $RECHECK")
        if [ "$as_json" = 1 ]; then
            printf '%s\n' "$items"
        else
            printf '%s' "$items" | jq -r "$RENDER_RECHECK"
        fi
        # Unlike audit, this one has an exit code: every row is an issue whose body has to be
        # edited, and a boot that scrolls past it silently is how the rule stopped being applied.
        printf '%s' "$items" | jq -e 'length == 0' >/dev/null
        ;;
    lint)
        findings=$(printf '%s' "$graph_json" | jq --arg lang_effective "$LANG_EFFECTIVE_DATE" "$JQ_LIB $LINT")
        if [ "$as_json" = 1 ]; then
            printf '%s\n' "$findings"
        else
            printf '%s' "$findings" | jq -r '.[] | .key + ": " + .reason'
        fi
        printf '%s' "$findings" | jq -e 'length == 0' >/dev/null
        ;;
    audit)
        # Local git is half of the audit: a branch or a worktree that outlived its issue is
        # only visible from the checkout, never from the API.
        merged=$(git branch --merged main --format='%(refname:short)' 2>/dev/null || true)
        # A wave branch is deleted on origin too when the wave ends (AGENTS.md), so the merged-wave
        # check needs remote-tracking refs as well as local ones -- `origin/HEAD` is a symbolic ref,
        # not a branch, and is dropped before it can be misread as a channel named "HEAD".
        merged_all=$(git branch --all --merged main --format='%(refname:short)' 2>/dev/null \
            | grep -v '^origin/HEAD$' || true)
        unmerged_all=$(git branch --all --no-merged main --format='%(refname:short)' 2>/dev/null \
            | grep -v '^origin/HEAD$' || true)
        worktrees=$(git worktree list --porcelain \
            | awk '/^worktree /{p=$2} /^branch /{b=$2; sub("refs/heads/", "", b); print p"\t"b}')
        # main, not the working tree: every worktree shares the ref but has its own edits, so a
        # worktree scan gives a different answer per checkout.
        todos=$(git grep -nE 'TODO\(#[0-9]+\)' main -- :/ 2>/dev/null || true)
        # #231 Work 6: a test file no map entry, reader entry, closure root or the smoke set could
        # ever select is a blind spot -- nothing but changing it directly ever runs it again.
        unreachable=$(python3 "$issue_tool_dir/change_scope.py" --unreachable 2>/dev/null || true)
        to_lines='split("\n") | map(select(length > 0))'
        primary=$(pick_primary)
        # #232 Work 3: the nightly's own section is first, ahead of everything git-derived below --
        # a red or missing nightly is the more urgent of the two kinds of drift this command reports.
        nightly_json=$(nightly_status "$primary")
        # #233 Work 3: ops signals, read the way tool/status's `== db ==` block reads them --
        # docker exec psql into cosmai-postgres, never through pick_primary (this is the database,
        # not a repo). Both queries have to succeed for the section to be "available" at all: a
        # query that dies partway through (a column renamed under a migration in flight) must read
        # as unavailable, not as a clean ops report.
        if command -v docker >/dev/null 2>&1 \
            && ops_pipeline=$(docker exec cosmai-postgres psql -U platform -d app -Atc \
                "select stage_key || ': ' || freshness from needs.pipeline_health
                 where freshness in ('late', 'stalled') order by stage_key" 2>/dev/null) \
            && ops_collector=$(docker exec cosmai-postgres psql -U platform -d app -Atc \
                "select collector || ':' || coalesce(dataset, '') || ' failed (run ' || run_id || ')'
                 from needs.collector_health where status = 'failed'
                 order by started_at desc limit 20" 2>/dev/null); then
            ops_available=true
        else
            ops_available=false
            ops_pipeline=""
            ops_collector=""
        fi
        ops_lines=$(printf '%s\n%s\n' "$ops_pipeline" "$ops_collector" | grep -v '^$' || true)
        # #175's own detector, called rather than reimplemented: judging "foreign" is one script's
        # job. `upstream` is the fork-checkout remote name; on an upstream checkout it does not
        # exist, so there is nothing to compare against and the section says so instead of erroring.
        if git remote get-url upstream >/dev/null 2>&1; then
            foreign_closes_cmd=${COSMAI_FOREIGN_CLOSES:-"$issue_tool_dir/checks/foreign-closes"}
            foreign_closes=$("$foreign_closes_cmd" "$primary" upstream 2>&1 || true)
            # The surfaces both repos have to keep identical: schema, the checks that enforce the
            # rules, the DDL contract and the boot page. A fork that falls behind on one of these
            # re-opens the same gap every migration wave closes, and only the checkout can see it.
            # Read, never fetched -- a boot command that reaches the network is a boot command that
            # hangs -- so a ref nobody has fetched is reported as unknown rather than as "up to date".
            if git rev-parse --verify -q upstream/main >/dev/null 2>&1; then
                behind=$(git log --format=%h upstream/main --not HEAD -- db/ tool/checks/ contracts/ddl/ AGENTS.md || true)
                behind_count=$(printf '%s' "$behind" | grep -c . || true)
                fork_behind=$(printf '%s' "$behind" | head -20)
                [ "$behind_count" -le 20 ] \
                    || fork_behind=$(printf '%s\n… and %s more' "$fork_behind" "$((behind_count - 20))")
                # The ownership boundary is one script's judgment too (#212, contracts/ownership.md).
                # Its stdout is one path per line and its exit code is the fork's pre-PR gate, not
                # this report's: audit stays exit 0 and prints what the check found.
                ownership_cmd=${COSMAI_OWNERSHIP_CHECK:-"$issue_tool_dir/checks/ownership"}
                ownership=$("$ownership_cmd" upstream/main 2>/dev/null || true)
            else
                fork_behind='(no upstream/main ref — nothing has been fetched from upstream)'
                ownership='(no upstream/main ref — nothing has been fetched from upstream)'
            fi
        else
            foreign_closes='(no upstream remote — skipped)'
            fork_behind='(no upstream remote — skipped)'
            ownership='(no upstream remote — skipped)'
        fi
        printf '%s' "$graph_json" | jq -r --argjson now "$now" --argjson stale_hours "$STALE_HOURS" \
            --argjson memo_days "$MEMO_DAYS" \
            --argjson nightly "$nightly_json" \
            --argjson ops_available "$ops_available" \
            --argjson ops "$(printf '%s' "$ops_lines" | jq -R -s "$to_lines")" \
            --arg primary "${primary##*/}" \
            --argjson merged "$(printf '%s' "$merged" | jq -R -s "$to_lines")" \
            --argjson merged_all "$(printf '%s' "$merged_all" | jq -R -s "$to_lines")" \
            --argjson unmerged_all "$(printf '%s' "$unmerged_all" | jq -R -s "$to_lines")" \
            --argjson worktrees "$(printf '%s' "$worktrees" | jq -R -s "$to_lines")" \
            --argjson todos "$(printf '%s' "$todos" | jq -R -s "$to_lines")" \
            --argjson unreachable "$(printf '%s' "$unreachable" | jq -R -s "$to_lines")" \
            --argjson foreign_closes "$(printf '%s' "$foreign_closes" | jq -R -s "$to_lines")" \
            --argjson fork_behind "$(printf '%s' "$fork_behind" | jq -R -s "$to_lines")" \
            --argjson ownership "$(printf '%s' "$ownership" | jq -R -s "$to_lines")" \
            "$JQ_LIB $AUDIT | $RENDER_AUDIT"
        ;;
    *) usage ;;
esac
